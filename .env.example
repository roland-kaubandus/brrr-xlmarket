# xlmarket.eu environment variables
# Kopeeri: cp .env.example .env && nano .env

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Medusa secrets
JWT_SECRET=CHANGE_ME_random_jwt_secret
COOKIE_SECRET=CHANGE_ME_random_cookie_secret

# Storefront (Docker)
NEXT_PUBLIC_MEDUSA_URL=http://127.0.0.1:9001
NEXT_PUBLIC_MEDUSA_KEY=pk_your_publishable_api_key_here
NEXT_PUBLIC_REGION_ID=reg_your_region_id_here

# Montonio (https://partner.montonio.com)
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
MONTONIO_ENVIRONMENT=sandbox

# Email (local Postfix)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=info@xlmarket.eu
EMAIL_ADMIN=tarmo@xlmarket.eu
EMAIL_INVOICE=risto.oitmaa@gmail.com
