# xlmarket.eu — environment variables
#
# Local dev:  cp .env.example .env && nano .env
# Coolify:    paste each var into Coolify UI -> Project -> Environment Variables.
#             Mark MEILI_MASTER_KEY, JWT_SECRET, COOKIE_SECRET, POSTGRES_PASSWORD
#             and MEDUSA_ADMIN_PASS as "Is Secret".

# ---------- Database ----------
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ---------- Medusa secrets ----------
JWT_SECRET=CHANGE_ME_random_jwt_secret_32_chars_min
COOKIE_SECRET=CHANGE_ME_random_cookie_secret_32_chars_min
MEDUSA_ADMIN_PASS=CHANGE_ME_admin_login_password

# ---------- CORS (point at your live domains) ----------
STORE_CORS=https://xlmarket.eu,https://xlmarket.ee
ADMIN_CORS=https://xlmarket.eu,https://admin.xlmarket.eu,https://xlmarket.ee
AUTH_CORS=https://xlmarket.eu,https://xlmarket.ee

# ---------- MeiliSearch ----------
# MEILI_MASTER_KEY is the root admin key (server-side only).
# MEILISEARCH_API_KEY is a legacy alias the Medusa plugin still reads — set to the same value.
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key_32_chars_min
MEILISEARCH_API_KEY=CHANGE_ME_meili_master_key_32_chars_min

# Search-only key (browser-exposed). Generate AFTER first Meili boot:
#   curl -H "Authorization: Bearer $MEILI_MASTER_KEY" http://meili:7700/keys
# Pick the "Default Search API Key" uid value and paste here.
NEXT_PUBLIC_MEILI_KEY=CHANGE_ME_search_only_key
NEXT_PUBLIC_MEILI_URL=https://meili.xlmarket.eu

# ---------- Storefront (Next.js) ----------
NEXT_PUBLIC_MEDUSA_URL=https://api.xlmarket.eu
NEXT_PUBLIC_MEDUSA_KEY=pk_your_publishable_api_key_here
NEXT_PUBLIC_REGION_ID=reg_your_region_id_here
NEXT_PUBLIC_BASE_URL=https://xlmarket.eu
NEXT_PUBLIC_DEFAULT_REGION=ee

# ---------- Feed sync (scripts/feed-sync.sh) ----------
MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_api_key_here
MEDUSA_REGION_ID=reg_your_region_id_here

# ---------- Montonio (https://partner.montonio.com) ----------
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
MONTONIO_ENVIRONMENT=sandbox

# ---------- Email ----------
# Coolify: route through an SMTP relay (Brevo, Postmark, AWS SES). Local Postfix not available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=info@xlmarket.eu
EMAIL_ADMIN=tarmo@xlmarket.eu
EMAIL_INVOICE=risto.oitmaa@gmail.com
