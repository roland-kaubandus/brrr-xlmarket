# xlmarket.eu environment variables
# Kopeeri: cp .env.example .env && nano .env

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Medusa secrets
JWT_SECRET=CHANGE_ME_random_jwt_secret
COOKIE_SECRET=CHANGE_ME_random_cookie_secret

# Montonio (https://partner.montonio.com)
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
MONTONIO_ENVIRONMENT=sandbox

# Email (SendGrid / Mailgun)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=info@xlmarket.eu
EMAIL_ADMIN=tarmo@xlmarket.eu
