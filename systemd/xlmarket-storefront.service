[Unit]
Description=XLMARKET Next.js Storefront
After=network.target xlmarket-medusa.service
Requires=xlmarket-medusa.service

[Service]
Type=simple
User=brrr
WorkingDirectory=/home/brrr/brrr-xlmarket/storefront
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=1024
EnvironmentFile=-/home/brrr/brrr-xlmarket/storefront/.env.local
ExecStart=/usr/bin/node node_modules/.bin/next start -p 3030
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
WatchdogSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xlmarket-storefront

[Install]
WantedBy=multi-user.target
