NEXT_PUBLIC_MEDUSA_URL=http://127.0.0.1:9001
NEXT_PUBLIC_MEDUSA_KEY=pk_your_publishable_api_key_here
NEXT_PUBLIC_REGION_ID=reg_your_region_id_here
NEXT_PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# xl-admin auth (KOHUSTUSLIK). Ilma nendeta kogu /xl-admin + /admin-login on
# FAIL-LOUD (lib/admin-env.ts kuvab puuduvate env-ide nimekirja, MITTE 500).
# Väärtused EI lähe git'i — Coolify UI env (staging) / prod env (cutover).
# ─────────────────────────────────────────────────────────────────────────────

# UI-värav — admin-cookie JWT allkiri + login (lib/admin-session.ts).
# Genereeri saladus: openssl rand -hex 32   (nõue: ≥32 märki)
ADMIN_SESSION_SECRET=
TARMO_ADMIN_EMAIL=tarmo@naissaar.eu
TARMO_ADMIN_PASS=

# storefront → Medusa teenuskonto, emailpass (lib/medusa-admin.ts).
# Loo konto serveris: npx medusa user -e <email> -p <tugev-parool>
MEDUSA_ADMIN_EMAIL=xl-admin-service@xlmarket.ee
MEDUSA_ADMIN_PASSWORD=

# Medusa backend base-URL. Docker/Coolify: http://medusa:9000 ; lokaal: http://127.0.0.1:9001
MEDUSA_BACKEND_URL=http://medusa:9000
